# 이 파일을 .env 로 복사한 뒤 실제 값을 채워넣으세요.
# .env 와 서비스 계정 JSON 은 절대 git 에 커밋하지 마세요.

# BotFather 에서 발급받은 텔레그램 봇 토큰
TELEGRAM_BOT_TOKEN=

# Google AI Studio 에서 발급받은 Gemini API 키
GEMINI_API_KEY=

# 스프레드시트 URL 의 /d/ 와 /edit 사이 문자열
SPREADSHEET_ID=

# 서비스 계정 키 파일명. bot_v2.py 와 같은 폴더에 두고 파일명만 적으면 됩니다.
# 해당 서비스 계정 이메일을 스프레드시트에 '편집자'로 공유해야 동작합니다.
GOOGLE_CREDENTIALS_FILE=

# juso.go.kr 도로명주소 검색 API 승인키 (https://www.juso.go.kr/addrlink/openApi/apiExplan.do)
# 비워두면 공개 테스트키(TESTJUSOGOKR)로 폴백합니다.
JUSO_CONFM_KEY=
